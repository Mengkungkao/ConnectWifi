{
  "info": [
    {
      "label": "CPU Temp",
      "command": "awk '{printf \"%.1f C\", $1 / 1000}' /sys/class/thermal/thermal_zone0/temp",
      "interval": 5
    },
    {
      "label": "CPU Load",
      "command": "awk '{printf \"%s\", $1}' /proc/loadavg",
      "interval": 2
    },
    {
      "label": "Memory",
      "command": "free -m | awk 'NR==2{printf \"%s/%sMB\", $3,$2 }'",
      "interval": 5
    },
    {
      "label": "UP Time",
      "command": "uptime -p | cut -d 'p' -f 2 | awk '{ printf \"%s\", $0 }'",
      "interval": 10
    }
  ],
  "commands": [
    {
      "label": "shutdown",
      "command": "shutdown"
    },
    {
      "label": "reboot",
      "command": "reboot"
    }
  ]
}
